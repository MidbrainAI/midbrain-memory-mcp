{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "midbrain",
            "tool": "save_memory",
            "input": { "text": "${prompt}", "role": "user", "session_id": "${session_id}" },
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "midbrain",
            "tool": "save_memory",
            "input": { "text": "${last_assistant_message}", "role": "assistant", "session_id": "${session_id}" },
            "timeout": 30
          }
        ]
      }
    ]
  }
}
